uit in enumerate(fruits):\n    print(f\"{i}: {fruit}\")\n\n# zip — pair two lists\nnames = [\"Ali\", \"Sara\", \"Bilal\"]\nscores = [85, 92, 78]\nfor name, score in zip(names, scores):\n    print(f\"{name}: {score}\")\n\n# sorted with key\nwords = [\"banana\", \"Apple\", \"cherry\"]\nprint(sorted(words, key=str.lower))","key":"gkaskTBRtG"},{"type":"outputs","id":"JRyvQlr2vY27cqy0XOxev","children":[],"key":"RiEkvWPCcf"}],"key":"IoNGyiHPN8"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"woZRJMtqfP"},{"type":"heading","depth":3,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Spot the Bug: Forgetting ","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"XaWw6CMKPl"},{"type":"inlineCode","value":"return","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"Cx41shYYy5"}],"identifier":"spot-the-bug-forgetting-return","label":"Spot the Bug: Forgetting return","html_id":"spot-the-bug-forgetting-return","implicit":true,"key":"LM0CqXVsPA"}],"key":"XJEf2WkASj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# BROKEN CODE — Why does result print None?\ndef add_bonus(salary, bonus):\n    total = salary + bonus\n\nresult = add_bonus(85000, 15000)\nprint(\"Pay:\", result)    # None!","key":"l1xBbf5cVI"},{"type":"outputs","id":"FepG65LiOudgGhbLEgwmi","children":[],"key":"kkWx9Tcnv0"}],"key":"jEbfoCaCsq"},{"type":"block","children":[{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Instructor Solution","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"mZvBgFXKtN"}],"key":"UzfBf5Fhod"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"If a function has no ","position":{"sta