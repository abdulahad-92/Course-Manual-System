uit in enumerate(fruits):\n    print(f\"{i}: {fruit}\")\n\n# zip — pair two lists\nnames = [\"Ali\", \"Sara\", \"Bilal\"]\nscores = [85, 92, 78]\nfor name, score in zip(names, scores):\n    print(f\"{name}: {score}\")\n\n# sorted with key\nwords = [\"banana\", \"Apple\", \"cherry\"]\nprint(sorted(words, key=str.lower))","key":"xy9GkIzYJ0"},{"type":"outputs","id":"Ds80usLhpKA-U1eyvs7LD","children":[],"key":"VRosFjWUgR"}],"key":"F6oe2srdgv"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"Ps2kngvzPa"},{"type":"heading","depth":3,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Spot the Bug: Forgetting ","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"zBX6PresOc"},{"type":"inlineCode","value":"return","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"a8YoRFC7ib"}],"identifier":"spot-the-bug-forgetting-return","label":"Spot the Bug: Forgetting return","html_id":"spot-the-bug-forgetting-return","implicit":true,"key":"eALe1JCcZV"}],"key":"iB876S7wv1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# BROKEN CODE — Why does result print None?\ndef add_bonus(salary, bonus):\n    total = salary + bonus\n\nresult = add_bonus(85000, 15000)\nprint(\"Pay:\", result)    # None!","key":"seMfecLVq4"},{"type":"outputs","id":"hzGmMgYj7yGkg0jiHxi92","children":[],"key":"CxTwOBMRUE"}],"key":"jZ5XhHFUBS"},{"type":"block","children":[{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"Instructor Solution","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"zNcVWWZBKH"}],"key":"oZ5Hwx0MvE"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"If a function has no ","position":{"sta