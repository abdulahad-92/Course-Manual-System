lock","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def calculate_gpa(total_marks, max_marks):\n    \"\"\"Calculate GPA on a 4.0 scale.\"\"\"\n    percentage = (total_marks / max_marks) * 100\n    if percentage >= 85:\n        return 4.0\n    elif percentage >= 70:\n        return 3.0\n    elif percentage >= 55:\n        return 2.0\n    else:\n        return 1.0\n\ngpa = calculate_gpa(340, 400)\nprint(f\"GPA: {gpa}\")","key":"lCQL4OlvnC"},{"type":"outputs","id":"oeG97xByZnfbQk6LY4Z0w","children":[],"key":"sPM29bHuiN"}],"key":"Q6YIV90aGM"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"qVEpsP3yYr"},{"type":"heading","depth":3,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Example 2: Default and Keyword Arguments","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"GYxqn8JrEY"}],"identifier":"example-2-default-and-keyword-arguments","label":"Example 2: Default and Keyword Arguments","html_id":"example-2-default-and-keyword-arguments","implicit":true,"key":"IDA7Migovz"}],"key":"WxK93jFp17"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def compute_tax(income, rate=0.05):\n    return income * rate\n\nprint(compute_tax(100000))              # Uses default 5%\nprint(compute_tax(100000, 0.10))        # Override to 10%\nprint(compute_tax(rate=0.07, income=200000))  # Keyword args","key":"HWprDrDkNJ"},{"type":"outputs","id":"s27VA7UfOj6w_ujybPgc4","children":[],"key":"BVpU7gmde7"}],"key":"g7mVZM9bma"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"D0ePDcGg4W"},{"type":"heading","depth":3,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Example 3: Returning Multiple Values","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"e80jw4DIbs"}],"identifier":"example-3-returning-multiple-values","label":"Example 3: Returning Multiple Values","html_id":"example-3-returning-multiple-values","implicit":true,"key":"WSI8zm21LT"}],"key":"tB5Pmpwtee"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def analyze_sales(sales_list):\n    return min(sales_list), max(sales_list), sum(sales_list) / len(sales_list)\n\nlow, high, avg = analyze_sales([45000, 89000, 120000, 67000])\nprint(f\"Low: {low}, High: {high}, Avg: {avg:.0f}\")","key":"GTPBaxwAGm"},{"type":"outputs","id":"1afv0Eq1uYOd8su_wrRvU","children":[],"key":"K9qyygbdYd"}],"key":"kl3rnm9EaV"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"guicTUXUwN"},{"type":"heading","depth":3,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Example 4: Variable Scope","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"TVtbk6FPVT"}],"identifier":"example-4-variable-scope","label":"Example 4: Variable Scope","html_id":"example-4-variable-scope","implicit":true,"key":"erfI54A0V9"}],"key":"AwhOabKP8Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"TAX_RATE = 0.05    # Global\n\ndef net_salary(gross):\n    deduction = gross * TAX_RATE    # deduction is LOCAL\n    return gross - deduction\n\nprint(net_salary(120000))\n# print(deduction)    # NameError — deduction doesn't exist here","key":"lEWYPCw4jq"},{"type":"outputs","id":"o4I0dBV8xO8JBn6WR957r","children":[],"key":"FSDisgZjKr"}],"key":"THAyi28QP6"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"R8JsDj931M"},{"type":"heading","depth":3,"posi