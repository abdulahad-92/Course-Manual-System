lock","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def calculate_gpa(total_marks, max_marks):\n    \"\"\"Calculate GPA on a 4.0 scale.\"\"\"\n    percentage = (total_marks / max_marks) * 100\n    if percentage >= 85:\n        return 4.0\n    elif percentage >= 70:\n        return 3.0\n    elif percentage >= 55:\n        return 2.0\n    else:\n        return 1.0\n\ngpa = calculate_gpa(340, 400)\nprint(f\"GPA: {gpa}\")","key":"HJBXbZeFM1"},{"type":"outputs","id":"7WOaGlmaGEf_TZatdVdaQ","children":[],"key":"yhYd4xcgFS"}],"key":"JiCiolyzZI"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"WTI8janixB"},{"type":"heading","depth":3,"position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Example 2: Default and Keyword Arguments","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"BTRffbwWmn"}],"identifier":"example-2-default-and-keyword-arguments","label":"Example 2: Default and Keyword Arguments","html_id":"example-2-default-and-keyword-arguments","implicit":true,"key":"Tuhs76L5pk"}],"key":"sXKg6v974s"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def compute_tax(income, rate=0.05):\n    return income * rate\n\nprint(compute_tax(100000))              # Uses default 5%\nprint(compute_tax(100000, 0.10))        # Override to 10%\nprint(compute_tax(rate=0.07, income=200000))  # Keyword args","key":"RMZEs9ReYN"},{"type":"outputs","id":"iKY1cxUJM-NrzL-fPn0z3","children":[],"key":"m4i70fpJ4i"}],"key":"wBKKKh03pi"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"E0kkZUrw8n"},{"type":"heading","depth":3,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Example 3: Returning Multiple Values","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"TlwntAkf05"}],"identifier":"example-3-returning-multiple-values","label":"Example 3: Returning Multiple Values","html_id":"example-3-returning-multiple-values","implicit":true,"key":"tTcFZKpM9c"}],"key":"WI9npcgzAV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def analyze_sales(sales_list):\n    return min(sales_list), max(sales_list), sum(sales_list) / len(sales_list)\n\nlow, high, avg = analyze_sales([45000, 89000, 120000, 67000])\nprint(f\"Low: {low}, High: {high}, Avg: {avg:.0f}\")","key":"CUdHmhmBdu"},{"type":"outputs","id":"MgIXRY30LxR4TH-LJrcIu","children":[],"key":"Q6JSRFcCIo"}],"key":"zgNk3hUgPt"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"WVQlVJ73Wt"},{"type":"heading","depth":3,"position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Example 4: Variable Scope","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"jF9XHtEI6x"}],"identifier":"example-4-variable-scope","label":"Example 4: Variable Scope","html_id":"example-4-variable-scope","implicit":true,"key":"idOqOAcGEP"}],"key":"t2CUAA8ZBF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"TAX_RATE = 0.05    # Global\n\ndef net_salary(gross):\n    deduction = gross * TAX_RATE    # deduction is LOCAL\n    return gross - deduction\n\nprint(net_salary(120000))\n# print(deduction)    # NameError — deduction doesn't exist here","key":"IyizJDq24Z"},{"type":"outputs","id":"75Epw0FaiB6zi1LC8RcU0","children":[],"key":"r9yaQVos7h"}],"key":"GjzAMga4q2"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"BXohWnNYGi"},{"type":"heading","depth":3,"posi