ebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# Create array of prices in PKR\nprices_pkr = np.array([1500, 2500, 8500, 32000, 1200])\n\n# Add 18% GST instantly across all items\nprices_with_tax = prices_pkr * 1.18\n\nprint(\"Original Prices (PKR) :\", prices_pkr)\nprint(\"Prices with GST (PKR) :\", np.round(prices_with_tax, 2))","key":"LqnalmsWts"},{"type":"outputs","id":"6VA8vIoL1UOXKED9-aL-h","children":[],"key":"B6HOAig6FE"}],"key":"MbRzJ0AoZy"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"SEQHioMxKy"},{"type":"heading","depth":3,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Example 2: Descriptive Array Statistics","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"V9lUpvlkRY"}],"identifier":"example-2-descriptive-array-statistics","label":"Example 2: Descriptive Array Statistics","html_id":"example-2-descriptive-array-statistics","implicit":true,"key":"KpZSYsMpsz"}],"key":"AnPgn8ysqk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sales_data = np.array([145000, 98000, 210000, 310000, 175000, 320000])\n\nprint(f\"Mean Revenue   : PKR {np.mean(sales_data):,.2f}\")\nprint(f\"Median Revenue : PKR {np.median(sales_data):,.2f}\")\nprint(f\"Std Deviation  : PKR {np.std(sales_data):,.2f}\")\nprint(f\"Max Sales Day  : PKR {np.max(sales_data):,.2f}\")","key":"zwoQEPSkAX"},{"type":"outputs","id":"Fa9Xf836qqzUP6t3Oo5_a","children":[],"key":"EkIwhd3vre"}],"key":"XFTFmPBgjq"}],"key":"NeJIK8WGkq"},"references":{"cite":{"order":[],"data":{}}}}