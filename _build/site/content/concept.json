l = subtotal + shipping\n\nprint(\"-\" * 30)\nprint(f\"Final Total to Charge: ${final_total:.2f}\")\nprint(\"------------------------------\")","position":{"start":{"line":43,"column":1},"end":{"line":83,"column":1}},"key":"wnfq4n7Lnp"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"🐛 The “Spot the Bug” Interactive Sandbox","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"qeK4MNISa6"}],"identifier":"id-the-spot-the-bug-interactive-sandbox","label":"🐛 The “Spot the Bug” Interactive Sandbox","html_id":"id-the-spot-the-bug-interactive-sandbox","implicit":true,"key":"SRj9is5OgL"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"A junior developer wrote the following script to categorize shipping box sizes based on item weight. However, ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"QfDn7uTIf4"},{"type":"strong","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"all items over 10 lbs are being shipped in “Medium” boxes instead of “Large” boxes, causing items to break!","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"FdIKd2OU15"}],"key":"Yfd4YlnwUe"}],"key":"wIMxjoKlML"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Can you spot the logical fallacy?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"Vj794b1meM"}],"key":"WORhlyDXnW"},{"type":"code","lang":"python","value":"item_weight_lbs = 15\n\n# Determine shipping box size\nif item_weight_lbs > 0:\n    box_size = \"Small\"\nelif item_weight_lbs > 5:\n    box_size = \"Medium\"\nelif item_weight_lbs > 10:\n    box_size = \"Large\"\nelse:\n    box_size = \"Invalid Weight\"\n\nprint(f\"Assigne